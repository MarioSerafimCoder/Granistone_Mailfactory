# Configure production values through GPT Sites environment settings.
# For local Worker development copy to .dev.vars (never commit real values).
SITE_ORIGIN=https://studio.example.com
EDITOR_EMAILS=local@studio.test
# Exact trusted hostnames only. Empty means remote images must be uploaded.
REMOTE_HOSTS=
# Keep the API key only in the server runtime environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
